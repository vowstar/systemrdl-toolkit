// Memory with no memwidth.
// EXPECT_ELABORATION_FAILURE: has no memwidth
//
// 11.3.1-d derives memwidth from the register width, and the size of a memory
// is mementries entries of that width. Without a width there is no size.
//
// This used to be answered with 4096 bytes regardless of what the source said,
// so every instance placed after the memory was at the wrong address. The
// reference implementation rejects the same input.
addrmap test_mem_no_memwidth {

    external mem {
        mementries = 1024;
    } data_mem @ 0x0;
};
